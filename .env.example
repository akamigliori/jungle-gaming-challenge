PORT=3000
LOG_LEVEL=info

# Postgres (docker compose publica na porta 5433 do host)
DB_HOST=localhost
DB_PORT=5433
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering

# SQS (LocalStack)
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Nomes das filas (permite que os testes usem filas próprias por suíte)
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo

# Publisher da outbox
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000

# Consumer SQS da fila de transações
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_LOOPS=2
SQS_RECEIVE_BATCH_SIZE=4
SQS_WAIT_TIME_SECONDS=10
SHUTDOWN_TIMEOUT_MS=20000

# Worker de referências pendentes
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
REFERENCE_RETRY_BASE_MS=2000
REFERENCE_RETRY_MAX_MS=60000
REFERENCE_MAX_ATTEMPTS=10
