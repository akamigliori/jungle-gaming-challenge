{
  "name": "jungle-gaming-challenge",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check:money": "bun scripts/check-money.ts",
    "check:architecture": "bun scripts/check-architecture.ts",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 30000",
    "test:concurrency": "bun test test/concurrency --timeout 30000",
    "test:multi-instance": "bun test test/multi-instance --timeout 180000",
    "demo": "bun scripts/demo.ts",
    "test:load": "bun scripts/load.ts",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1147.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "decimal.js": "10.6.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nestjs/testing": "12.2.0",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
